# Lukas Fibonacci — a rotating double-sided desktop card for Übersicht.
# One number controls the whole card size:

size = 354

command: 'echo ""'

refreshFrequency: 3600000

display: 'main'

render: (output) -> """
  <div class='scene'>
    <div class='flip'>
      <div class='face front'><img src="data:image/jpeg;base64,"></div>
      <div class='face back'>
        <div class='back-inner'>
          <div class='b-name'>Lukas</div>
          <div class='b-sub'>FIBONACCI</div>
          <div class='b-ratio'>1.6180339887</div>
        </div>
      </div>
    </div>
  </div>
"""

style: """
  top: 15px
  left: 1076px
  font-family: -apple-system, 'SF Pro Display', system-ui, sans-serif

  .scene
    width: #{size}px
    height: #{size}px
    perspective: 1200px

  .flip
    width: 100%
    height: 100%
    position: relative
    transform-style: preserve-3d
    animation: flip 6s linear infinite

  @keyframes flip
    0%   { transform: rotateY(0deg) }
    100% { transform: rotateY(360deg) }

  .face
    position: absolute
    top: 0
    left: 0
    width: 100%
    height: 100%
    border-radius: 18px
    overflow: hidden
    backface-visibility: hidden
    -webkit-backface-visibility: hidden
    border: 1px solid rgba(255, 255, 255, 0.1)
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35)

  .front img
    width: 100%
    height: 100%
    object-fit: cover
    display: block

  .back
    transform: rotateY(180deg)
    background: rgba(20, 20, 24, 0.92)
    display: flex
    align-items: center
    justify-content: center

  .back-inner
    text-align: center

  .b-name
    font-size: #{Math.round(size * 0.15)}px
    font-weight: 800
    letter-spacing: -1px
    color: #F7F5F2

  .b-sub
    font-size: #{Math.round(size * 0.045)}px
    font-weight: 500
    letter-spacing: #{Math.round(size * 0.023)}px
    color: #7C3AED
    margin-top: 6px
    padding-left: #{Math.round(size * 0.023)}px

  .b-ratio
    font-size: #{Math.round(size * 0.031)}px
    letter-spacing: 3px
    color: rgba(255, 255, 255, 0.35)
    margin-top: #{Math.round(size * 0.06)}px
"""
